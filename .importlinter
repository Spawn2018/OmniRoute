[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:warstwy]
name = Warstwy
type = layers
layers =
    app.api
    app.workflows
    app.services
    app.repositories
    app.models

[importlinter:contract:moduly]
name = Niezależność modułów domenowych
type = independence
modules =
    app.services.tenancy
    app.services.extraction
    app.services.charge_codes
    app.services.rate_lines
    app.services.charges
    app.services.quotations
    app.services.organization_settings
    app.services.geography
    app.services.parties
    app.services.commodity_codes
    app.services.nbp_rates
    app.services.dangerous_goods
    app.services.document_checklist_rules
    app.services.document_dispatch_rules
    app.services.booking_instructions
    app.services.field_carry_forwards
    app.services.networks
    app.services.carrier_inquiries
    app.services.inbound_messages
    app.services.incoterm_responsibilities
    app.services.customer_rfqs
    app.services.operator_decisions
    app.services.operator_notices
    app.services.mail_drafts
    app.services.outbox_events
    app.services.entity_events
    app.services.port_surcharges
    app.services.channel_quotes
    app.services.shipments
    app.services.shipment_stakeholders
    app.services.tracking_events
    app.services.shipment_documents
    app.services.operational_exceptions
    app.services.cargo_claims
    app.services.fraud_flags
    app.services.edi_messages
    app.services.sales_invoices
    app.services.quote_invoice_settlements
    app.services.bank_payments
    app.services.money_costs
    app.services.fx_differences
    app.services.cash_flows
    app.services.cost_to_serve
    app.services.bookkeeping
    app.services.collective_invoices
    app.services.gdpr_requests
    app.services.shipment_legs

[importlinter:contract:integracje]
name = Integracje nie znają serwisów
type = forbidden
source_modules = app.integrations
forbidden_modules = app.services

[importlinter:contract:domena]
name = Domena bez zależności zewnętrznych
type = forbidden
source_modules = app.domain
forbidden_modules =
    fastapi
    sqlalchemy
    httpx

[importlinter:contract:extraction-no-rates]
name = Extraction nie zna stawek ani charge
type = forbidden
source_modules =
    app.services.extraction
    app.repositories.extraction
forbidden_modules =
    app.services.rate_lines
    app.services.charges
    app.repositories.rate_lines
    app.repositories.charges
    app.services.quotations
    app.repositories.quotations
    app.models.rate_line
    app.models.charge
    app.models.quotation
    app.services.organization_settings
    app.repositories.organization_settings
    app.models.organization_setting
    app.services.parties
    app.repositories.parties
    app.models.party
    app.models.party_scorecard
    app.models.credit_review
    app.models.customer_sop
    app.services.commodity_codes
    app.repositories.commodity_codes
    app.models.commodity_code
    app.services.nbp_rates
    app.repositories.nbp_rates
    app.models.nbp_rate
    app.services.dangerous_goods
    app.repositories.dangerous_goods
    app.models.dangerous_good
    app.services.document_checklist_rules
    app.repositories.document_checklist_rules
    app.models.document_checklist_rule
    app.services.document_dispatch_rules
    app.repositories.document_dispatch_rules
    app.models.document_dispatch_rule
    app.services.booking_instructions
