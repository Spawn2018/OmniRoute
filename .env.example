# GitHub MCP (Cursor: Customize → MCP → github)
# Wygeneruj: gh auth token
GITHUB_PAT=

# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql+asyncpg://omniroute:omniroute@localhost:5432/omniroute
DATABASE_URL_SYNC=postgresql://omniroute:omniroute@localhost:5432/omniroute

# Test DB (pytest)
TEST_DATABASE_URL=postgresql+asyncpg://omniroute:omniroute@localhost:5432/omniroute_test
ADMIN_TEST_DATABASE_URL=postgresql+asyncpg://omniroute:omniroute@localhost:5432/omniroute_test
TENANT_TEST_DATABASE_URL=postgresql+asyncpg://tenant_tester:test@localhost:5432/omniroute_test

# OpenFGA (docker compose up -d openfga)
OPENFGA_API_URL=http://localhost:8080
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

# Langfuse (opcjonalnie — bez kluczy tracer jest no-op)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Ekstrakcja 0.8 — CI zostaje na mock; instructor wymaga klucza (nigdy w logach)
# EXTRACTION_PROVIDER=mock
# EXTRACTION_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# EXTRACTION_LLM_GUARD=false
# EXTRACTION_PARSER=stub
# stub | ab | docling  (docling: pip install -e ".[parsers]")

# Sesja JWT hello (HS256) — min. 32 znaki; nigdy w logach
JWT_SECRET=change-me-local-only-not-for-production
# JWT_EXPIRE_MINUTES=60

# Frontend (opcjonalnie — bez klucza PostHog jest no-op)
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com
