    define member: [user]
    define reviewer: [user]
    define can_list_users: member
    define can_manage_table_views: member
    define can_review_extractions: reviewer
    define can_manage_charge_codes: member
    define can_manage_rate_lines: member
    define can_manage_charges: member
    define can_manage_quotations: member
    define can_manage_organization_settings: member
    define can_manage_geography: member
    define can_manage_parties: member
